# DP_TurnOffSinkFaucet_baseline: fixed experiment defaults.

: "${KOURO_EXPERIMENT_ID:=DP_TurnOffSinkFaucet_baseline}"
: "${KOURO_TASK:=TurnOffSinkFaucet}"
: "${KOURO_TASK_DATE:=20250819}"
: "${KOURO_NUM_EPISODES:=100}"
: "${KOURO_POLICY_TYPE:=diffusion}"
: "${KOURO_POLICY_DIR:=policy/diffusion}"
: "${KOURO_STEPS:=20000}"
: "${KOURO_BATCH_SIZE:=32}"
: "${KOURO_NUM_WORKERS:=8}"
: "${KOURO_PREFETCH_FACTOR:=4}"
: "${KOURO_LOG_FREQ:=100}"
: "${KOURO_SAVE_FREQ:=2000}"
: "${KOURO_EVAL_FREQ:=2000}"
: "${KOURO_INLINE_EVAL_EPISODES:=5}"
: "${KOURO_SEED:=42}"
: "${KOURO_USE_AMP:=false}"
: "${KOURO_PRETRAINED_BACKBONE:=ResNet18_Weights.IMAGENET1K_V1}"
: "${KOURO_STATE_ROTATION_REPRESENTATION:=rotation_6d}"

: "${KOURO_N_OBS_STEPS:=2}"
: "${KOURO_HORIZON:=64}"
: "${KOURO_N_ACTION_STEPS:=32}"
: "${KOURO_DROP_N_LAST_FRAMES:=7}"

: "${KOURO_FINAL_EVAL_EPISODES:=50}"
: "${KOURO_EVAL_SPLIT:=pretrain}"
: "${KOURO_TENSORBOARD_PORT:=6006}"
