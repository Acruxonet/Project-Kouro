# ACT_TurnOffSinkFaucet_baseline: fixed experiment defaults.

: "${KOURO_EXPERIMENT_ID:=ACT_TurnOffSinkFaucet_baseline}"
: "${KOURO_TASK:=TurnOffSinkFaucet}"
: "${KOURO_TASK_DATE:=20250819}"
: "${KOURO_NUM_EPISODES:=100}"
: "${KOURO_POLICY_TYPE:=act}"
: "${KOURO_POLICY_DIR:=policy/act}"
: "${KOURO_STEPS:=100000}"
: "${KOURO_BATCH_SIZE:=8}"
: "${KOURO_NUM_WORKERS:=8}"
: "${KOURO_PREFETCH_FACTOR:=4}"
: "${KOURO_LOG_FREQ:=100}"
: "${KOURO_SAVE_FREQ:=10000}"
: "${KOURO_EVAL_FREQ:=10000}"
: "${KOURO_INLINE_EVAL_EPISODES:=5}"
: "${KOURO_SEED:=42}"
: "${KOURO_USE_AMP:=false}"
: "${KOURO_STATE_ROTATION_REPRESENTATION:=rotation_6d}"

: "${KOURO_ACT_CHUNK_SIZE:=100}"
: "${KOURO_ACT_N_ACTION_STEPS:=100}"
